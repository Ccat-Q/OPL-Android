<Window x:Class="OPL_WpfApp.minui.copy_ui"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:local="clr-namespace:OPL_WpfApp.minui"
        Title="手动复制" Height="320" Width="480" MinHeight="280" MinWidth="400" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="手动复制联机码" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBox Grid.Row="1" TextWrapping="Wrap" Text="TextBlock" Name="copybox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Grid.Row="2" Text="若自动复制失败，请选中上方文本后按 Ctrl+C。" Margin="0,12,0,12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        <Button Grid.Row="3" Content="关闭" Click="Button_Click" HorizontalAlignment="Right" Width="100"/>
    </Grid>
</Window>
