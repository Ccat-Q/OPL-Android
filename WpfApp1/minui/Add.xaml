<Window x:Class="OPL_WpfApp.Add"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPL_WpfApp"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        MinHeight="440" MinWidth="440" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Title="添加隧道" Height="440" Width="460" ResizeMode="NoResize" ShowInTaskbar="False">
        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="添加隧道" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="带 * 的项目为必填项" Margin="0,4,0,18"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="名称" Target="{Binding ElementName=names}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="names" Text="自定义" MinHeight="36" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Content="UID *" Target="{Binding ElementName=SUID}" VerticalAlignment="Center" ToolTip="输入房主的 UID"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SUID" MinHeight="36" VerticalContentAlignment="Center"/>
                <Label Grid.Row="2" Content="远程端口 *" Target="{Binding ElementName=Sport}" VerticalAlignment="Center" ToolTip="输入房主游戏对外开放的端口"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="Sport" MinHeight="36" VerticalContentAlignment="Center" TextChanged="Sport_TextChanged"/>
                <Label Grid.Row="3" Content="本地端口" Target="{Binding ElementName=Cport}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="Cport" MinHeight="36" VerticalContentAlignment="Center"/>
                <Label Grid.Row="4" Content="协议 *" Target="{Binding ElementName=type}" VerticalAlignment="Center" ToolTip="Minecraft 请选择 TCP"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="type" MinHeight="36" VerticalContentAlignment="Center" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="tcp" IsSelected="True"/>
                        <ComboBoxItem Content="udp"/>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="使用预设" MinWidth="96" Height="38" Click="Preset"/>
                <Button Grid.Column="2" Content="取消" MinWidth="80" Height="38" IsCancel="True"/>
                <Button Grid.Column="4" Content="添加隧道" MinWidth="112" Height="38" Click="Button_Click" IsDefault="True" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
            </Grid>
        </Grid>
</Window>
