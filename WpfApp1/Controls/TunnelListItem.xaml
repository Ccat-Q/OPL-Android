<UserControl x:Class="OPL_WpfApp.Controls.TunnelListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             HorizontalAlignment="Stretch"
             AllowDrop="True" DragEnter="TunnelListItem_DragEnter"
             DragLeave="TunnelListItem_DragLeave" Drop="TunnelListItem_Drop"
             FontSize="13" KeyboardNavigation.TabNavigation="Local">
    <Border x:Name="CardBorder" Margin="0,0,0,8" Padding="14,12" CornerRadius="8"
            RenderTransformOrigin="0.5,0.5"
            Background="#12FFFFFF" BorderBrush="#327F7F7F" BorderThickness="1">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale"/>
                <TranslateTransform x:Name="CardOffset"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1" x:Name="UidText" Margin="0,6,12,0" FontFamily="Consolas"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Column="1" x:Name="ProtocolText" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Grid.Row="1" x:Name="PortText" Margin="0,6,12,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

            <TextBlock Grid.Column="2" Text="本地连接地址" FontSize="12"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <TextBox Grid.Column="2" Grid.Row="1" x:Name="AddressText" Margin="0,4,8,0"
                     IsReadOnly="True" FontFamily="Consolas" Cursor="Hand"
                     PreviewMouseLeftButtonUp="Copy_Click" ToolTip="单击复制此 IP 和端口"/>

            <StackPanel Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,6,0" Stroke="#667F7F7F"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="EnabledCheckBox" Content="启用" Margin="0,8,0,0"
                          Checked="EnabledCheckBox_Changed" Unchecked="EnabledCheckBox_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="4" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="EditButton" Content="编辑" Click="Edit_Click" Margin="0,0,6,0"/>
                <Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" Margin="0,0,6,0" ToolTip="删除后无法恢复"/>
                <Border x:Name="DragHandle" Width="36" Height="36" Background="Transparent" Cursor="SizeAll"
                        ToolTip="拖动到其他隧道以调整顺序" AutomationProperties.Name="拖动排序"
                        PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        PreviewMouseMove="DragHandle_MouseMove">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_20_Regular}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
