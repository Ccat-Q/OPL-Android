<Window x:Class="OPL_WpfApp.edit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPL_WpfApp"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="编辑隧道" Height="390" Width="420" MinHeight="360" MinWidth="390" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="编辑隧道" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="1">
            <DockPanel Margin="0,5"><TextBlock Text="名称" Width="100" VerticalAlignment="Center"/><TextBox x:Name="names"/></DockPanel>
            <DockPanel Margin="0,5"><TextBlock Text="UID *" Width="100" VerticalAlignment="Center"/><TextBox Name="SUID" ToolTip="房主 UID"/></DockPanel>
            <DockPanel Margin="0,5"><TextBlock Text="远程端口 *" Width="100" VerticalAlignment="Center"/><TextBox Name="Sport"/></DockPanel>
            <DockPanel Margin="0,5"><TextBlock Text="本地端口" Width="100" VerticalAlignment="Center"/><TextBox Name="Cport"/></DockPanel>
            <DockPanel Margin="0,5"><TextBlock Text="协议 *" Width="100" VerticalAlignment="Center"/><ComboBox Name="type" SelectionChanged="ComboBox_SelectionChanged"><ComboBoxItem Content="tcp"/><ComboBoxItem Content="udp"/></ComboBox></DockPanel>
        </StackPanel>
        <Button Grid.Row="2" Content="保存更改" Height="38" Click="Button_Click" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
    </Grid>
</Window>
