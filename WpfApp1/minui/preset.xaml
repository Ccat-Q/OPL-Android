<Window x:Class="OPL_WpfApp.preset"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPL_WpfApp"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="预设" Height="320" Width="420" MinHeight="300" MinWidth="380" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="从预设添加" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBlock Grid.Row="1" Text="房主 UID" Margin="0,0,0,6"/>
        <TextBox Grid.Row="2" Name="SUID" ToolTip="输入房主的 UID"/>
        <TextBlock Grid.Row="3" Text="游戏" Margin="0,14,0,6"/>
        <ComboBox Grid.Row="4" Name="type" SelectionChanged="ComboBox_SelectionChanged"/>
        <Button Grid.Row="6" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" Content="添加预设隧道" Height="38" Click="Button_Click"/>
    </Grid>
</Window>
