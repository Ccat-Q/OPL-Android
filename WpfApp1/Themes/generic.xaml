<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OPL_WpfApp.easyTier"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <Style TargetType="{x:Type local:etinfo}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="BorderBrush" Value="#FF808080"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:etinfo}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="#327F7F7F" BorderThickness="1"
                            Padding="14,12" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="70"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Hostname}" FontSize="15"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,12,0">
                                    <TextBlock x:Name="IpTextBlock" Text="{TemplateBinding IpAddress}"
                                               VerticalAlignment="Center" FontFamily="Consolas"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="PART_CopyButton" Width="30" Height="30" Margin="6,0,0,0"
                                            Padding="0" ToolTip="复制 IP 地址"
                                            AutomationProperties.Name="复制 IP 地址">
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Copy_20_Regular}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="下载" FontSize="12"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <TextBlock Text="{TemplateBinding RxData}" Margin="0,4,8,0"
                                           FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="上传" FontSize="12"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <TextBlock Text="{TemplateBinding TxData}" Margin="0,4,8,0"
                                           FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="延迟" FontSize="12"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{TemplateBinding BorderBrush}"
                                             Stroke="#667F7F7F" Margin="0,0,6,0"/>
                                    <TextBlock Text="{TemplateBinding LatMs}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
