<Window x:Class="OPL_WpfApp.MainWindow_opl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:test="clr-namespace:test"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Height="40" ui:TitleBar.IsIconVisible="True"
        Title="OpenP2P Launcher · 联机工具"
        Width="1060" Height="640" MinWidth="980" MinHeight="540"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        KeyboardNavigation.TabNavigation="Continue"
        StateChanged="Window_StateChanged" Activated="Show" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#327F7F7F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="NavHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Width" Value="174"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="TextElement.FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl BorderBrush="{x:Null}" TabStripPlacement="Left" Margin="8,8,8,0"
                    ui:TabControlHelper.IsAddTabButtonVisible="False">
            <ui:TabControlHelper.TabStripFooter>
                <Button Click="Button_help" Width="194" Height="48" Margin="10" Padding="14,10"
                        AutomationProperties.Name="获取帮助">
                    <ui:IconAndText Icon="{x:Static ui:FluentSystemIcons.Lightbulb_20_Regular}"
                                    x:Name="Theme" Content="获取帮助"/>
                </Button>
            </ui:TabControlHelper.TabStripFooter>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource NavHeader}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Link_20_Regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="隧道" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="隧道管理" Style="{StaticResource PageTitle}"/>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="本机 UID" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" x:Name="UID" IsReadOnly="True" Text="AAAAAAAAAAAAAAAA" FontFamily="Consolas"/>
                            <Button Grid.Column="2" Content="复制" Click="CopyUID_Button_Click" Margin="8,0,20,0"/>
                            <TextBlock Grid.Column="3" Text="共享带宽" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="4" x:Name="share" Width="54" TextChanged="share_TextChanged"/>
                            <TextBlock Grid.Column="5" Text="Mbps" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Button Grid.Column="6" Content="快速添加" Click="Quick_Add" Margin="12,0,8,0" ToolTip="从剪贴板中的联机码自动添加"/>
                            <Button Grid.Column="7" Content="新建连接" Click="Button_Click" Padding="16,8"
                                    Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="sdlist"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                             AutomationProperties.Name="隧道列表">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource NavHeader}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_20_Regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="EasyTier" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="EasyTier 组网" Style="{StaticResource PageTitle}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*" MinWidth="280"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="网络节点" Style="{StaticResource SectionTitle}"/>
                                <ListBox Grid.Row="1" x:Name="NetworkList" Margin="0,8,0,0"
                                         BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="EasyTier 网络节点">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="连接设置" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="当前网络" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="newetuid" Text="未连接" IsReadOnly="True" Margin="0,4,0,14"/>
                                <TextBlock Text="节点地址" Style="{StaticResource Caption}"/>
                                <Border Margin="0,4,0,6" Padding="8,8,2,2" MinHeight="48" MaxHeight="104"
                                        CornerRadius="8" BorderBrush="#327F7F7F" BorderThickness="1" Background="#0AFFFFFF">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="EasyTierPeersList" AutomationProperties.Name="EasyTier 节点列表">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,6" Padding="8,4,4,4" CornerRadius="14"
                                                            Background="#147F7F7F" BorderBrush="#327F7F7F" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                            <Button Tag="{Binding}" Click="RemoveEasyTierPeer_Click"
                                                                    Width="24" Height="24" Margin="6,0,0,0" Padding="0"
                                                                    ToolTip="删除节点" AutomationProperties.Name="删除节点">
                                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Dismiss_12_Regular}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="EasyTierPeerInput" KeyDown="EasyTierPeerInput_KeyDown"
                                             ToolTip="输入节点地址；可一次粘贴多个地址"/>
                                    <Button Grid.Column="2" Content="添加" Click="AddEasyTierPeer_Click"/>
                                </Grid>
                                <Button Content="创建网络" Click="crearEtNet" Margin="0,0,0,18" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                                <TextBlock Text="加入已有网络" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="etNetText" Margin="0,4,0,8" ToolTip="输入网络 UID"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="加入网络" Click="joinEtNet"/>
                                    <Button Grid.Column="2" Content="退出网络" Click="leaveEtNet"/>
                                </Grid>
                                <Button Content="查看帮助" Click="EThelp" Margin="0,14,0,0"/>
                                <TextBlock Text="实验性功能 · 由 EasyTier 提供服务" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource NavHeader}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_20_Regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="OpenP2P" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="OpenP2P 虚拟组网" Style="{StaticResource PageTitle}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="创建网络" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="通讯端口" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="tunport" Text="25674" Margin="0,4,0,16"/>
                                <TextBlock Text="创建后会自动生成联机码，其他成员可通过右侧加入。" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                                <Button x:Name="tunbutton" Content="创建/开启网络" Click="Opentun" Height="40" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="加入网络" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="本机 IP 末位（2–20，且不可重复）" Style="{StaticResource Caption}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                    <TextBlock Text="10.0.23." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="tunip" Text="2" Width="64"/>
                                </StackPanel>
                                <TextBlock Text="联机码" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="tunlink" Margin="0,4,0,16"/>
                                <Button x:Name="tunjoinbutton" Content="连接网络" Click="jointun" Height="40"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="tunellipse" Fill="Gray" Stroke="#667F7F7F" Width="12" Height="12" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="组网状态" VerticalAlignment="Center"/>
                            <Label Grid.Column="2" x:Name="tunspeed" Content="流量信息" VerticalAlignment="Center" Margin="16,0"/>
                            <TextBox Grid.Column="3" x:Name="iptext" IsReadOnly="True" Width="180" Margin="0,0,8,0"/>
                            <Button Grid.Column="4" Content="复制 IP" Click="copytunip"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Style="{StaticResource NavHeader}"><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.WindowConsole_20_Regular}" Margin="0,0,10,0"/><TextBlock Text="日志" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="运行日志" Style="{StaticResource PageTitle}"/>
                    <TextBox Grid.Row="1" x:Name="richOutput" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="运行日志"/>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Style="{StaticResource NavHeader}"><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Speaker2_20_Regular}" Margin="0,0,10,0"/><TextBlock Text="公告" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="公告" Style="{StaticResource PageTitle}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="notice" AutomationProperties.Name="公告列表">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding time}" Style="{StaticResource Caption}" Margin="24,3,0,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding content}" Margin="0,14,0,0" LineHeight="22" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Style="{StaticResource NavHeader}"><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Settings_20_Regular}" Margin="0,0,10,0"/><TextBlock Text="设置" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,16,16,16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="启动与维护" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="Autoup_opn" Content="校验 openp2p 文件" Margin="0,6"/>
                                    <CheckBox x:Name="Autoup_etn" Content="自动更新 EasyTier 核心" Margin="0,6"/>
                                    <CheckBox x:Name="Autoupn" Content="自动更新主程序" Margin="0,6"/>
                                    <CheckBox x:Name="Autoup_bootn" Content="开机自动运行" Margin="0,6"/>
                                    <CheckBox x:Name="Autoup_openn" Content="启动程序后自动开启服务" Margin="0,6"/>
                                    <CheckBox x:Name="Ispwarning" Content="显示运营商检测警告" Margin="0,6"/>
                                    <CheckBox x:Name="minimize" Content="关闭窗口时最小化到托盘" Margin="0,6"/>
                                    <CheckBox x:Name="CleanLogCheck" Content="退出时清理日志缓存" Margin="0,6"/>
                                    <Button Content="添加 Windows 安全中心排除项" Click="AddMpBotton" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="连接节点" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="参与者必须使用相同节点。备用节点仅建议在主节点失效时临时使用。" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                                        <ComboBox x:Name="ServersCombo" SelectionChanged="ServersCombo_SelectionChanged"><ComboBoxItem Content="正在获取节点…" IsSelected="True"/></ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="应用主题" Style="{StaticResource Caption}"/>
                                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" Margin="0,4,0,16">
                                            <ComboBoxItem Content="跟随系统" x:Name="Theme_auto"/><ComboBoxItem Content="浅色" x:Name="Theme_Light"/><ComboBoxItem Content="深色" x:Name="Theme_Dark"/>
                                        </ComboBox>
                                        <TextBlock Text="强调色" Style="{StaticResource Caption}"/>
                                        <test:ColorPicker x:Name="ColorBlock" SelectColor="Black" Height="40" Margin="0,4,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Content="应用颜色" Click="ColorPicker_Set" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                                            <Button Grid.Column="2" Content="恢复系统配色" Click="ColorPicker_ReSet"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Style="{StaticResource NavHeader}"><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PersonSettings_20_Regular}" Margin="0,0,10,0"/><TextBlock Text="关于" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="关于 OpenP2P Launcher" Style="{StaticResource PageTitle}"/>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="帮助文档" Click="Openwiki" Margin="0,0,8,0"/><Button Grid.Column="1" Content="作者主页" Click="OpenMe" Margin="0,0,8,0"/><Button Grid.Column="2" Content="GitHub" Click="OpenGit"/>
                        <Button Grid.Column="4" Content="导出日志" Click="ExportLog" Margin="0,0,8,0"/><Button Grid.Column="5" Content="重置程序" Click="ResetUID_Button_Click" ToolTip="重置 UID 并删除全部隧道配置"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*" MinWidth="180"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="更新日志" Style="{StaticResource SectionTitle}"/><TextBox Grid.Row="1" x:Name="uplogbox" Text="联网获取中" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="鸣谢" Style="{StaticResource SectionTitle}"/><TextBox Grid.Row="1" x:Name="thank" Text="联网获取中" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="2" Text="基于 OpenP2P · 内容联网获取" Style="{StaticResource Caption}" Margin="0,12,0,0"/></Grid></Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" BorderBrush="#327F7F7F" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="fstert" Fill="Gray" Stroke="#667F7F7F" Width="10" Height="10" Margin="0,0,8,0"/>
                <Label Grid.Column="1" x:Name="ver" Content="v1.0.1.9" Padding="0" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Content="导出连接码" Click="Outlist" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="生成联机码" Click="Multput" Margin="0,0,8,0"/>
                <Button Grid.Column="5" Content="关闭所有隧道" Click="CloseAll" Margin="0,0,8,0"/>
                <Button Grid.Column="6" x:Name="openbutton" Content="启动" Click="Button_Click_open" Width="112" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
